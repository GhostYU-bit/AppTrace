<Project>

  <!--
    Shared build settings for every AppTrace project.
    AppTrace targets Windows only: the registry APIs and the well-known
    folder layout it depends on are Windows-specific by design.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>AppTrace</Product>
    <Authors>AppTrace contributors</Authors>
    <Version>0.1.0</Version>
    <!-- CA1305: AppTrace reports in the invariant format the CLI expects. -->
    <NoWarn>$(NoWarn);CA1303;CA1305;CA1848;CA2007</NoWarn>
  </PropertyGroup>

</Project>
